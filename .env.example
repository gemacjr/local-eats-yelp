# Copy to .env (docker compose reads it automatically).
# Required only for LocalStack images that need an account token (2026.x tags).
LOCALSTACK_AUTH_TOKEN=
# Any string >= 32 bytes.
JWT_SECRET=local-dev-secret-change-me-at-least-32-bytes!!
# Host ports (change if they collide with other local stacks).
POSTGRES_HOST_PORT=5434
LOCALSTACK_HOST_PORT=4568
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
